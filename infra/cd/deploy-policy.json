{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeployToTheDemoFunctionOnly",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetFunctionUrlConfig",
        "lambda:UpdateFunctionCode",
        "lambda:PublishVersion",
        "lambda:GetAlias",
        "lambda:UpdateAlias"
      ],
      "Resource": [
        "arn:aws:lambda:ap-northeast-1:<ACCOUNT_ID>:function:<FUNCTION_NAME>",
        "arn:aws:lambda:ap-northeast-1:<ACCOUNT_ID>:function:<FUNCTION_NAME>:*"
      ]
    },
    {
      "Sid": "ReadThePinnedPublicLayerVersionOnly",
      "Effect": "Allow",
      "Action": "lambda:GetLayerVersion",
      "Resource": "arn:aws:lambda:ap-northeast-1:753240598075:layer:LambdaAdapterLayerX86:28"
    }
  ]
}
